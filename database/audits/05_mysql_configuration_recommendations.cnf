# ============================================
# MySQL Configuration Recommendations
# ============================================
# Purpose: Optimized settings for ERP inventory system
# File: my.cnf (Linux) or my.ini (Windows)
# ============================================

[mysqld]
# ============================================
# Basic Settings
# ============================================
user = mysql
port = 3306
socket = /var/lib/mysql/mysql.sock
datadir = /var/lib/mysql

# Character Set and Collation
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'

# Time Zone
default-time-zone = '+00:00'

# ============================================
# Connection Settings
# ============================================
max_connections = 500
max_connect_errors = 100000
wait_timeout = 28800
interactive_timeout = 28800

# Connection pool for high concurrency
thread_cache_size = 100
thread_stack = 256K

# ============================================
# InnoDB Settings (Critical for ERP)
# ============================================

# Buffer Pool Size - Most Important Setting
# Set to 70-80% of available RAM for dedicated database server
# For 8GB RAM: innodb_buffer_pool_size = 6G
# For 16GB RAM: innodb_buffer_pool_size = 12G
# For 32GB RAM: innodb_buffer_pool_size = 24G
innodb_buffer_pool_size = 6G

# Buffer Pool Instances (for multi-core systems)
# Set to number of CPU cores or divide buffer pool by 1GB
innodb_buffer_pool_instances = 8

# Log File Size - Larger = Better Performance
# Set to 25% of buffer pool size, minimum 256MB
innodb_log_file_size = 1G
innodb_log_files_in_group = 2

# Log Buffer Size
innodb_log_buffer_size = 64M

# Flush Method
# 1 = Flush to OS and sync to disk (safest, slowest)
# 2 = Flush to OS, sync every second (good balance)
# 0 = Flush to OS only (fastest, risk of data loss on crash)
innodb_flush_log_at_trx_commit = 2

# Flush Method for I/O
innodb_flush_method = O_DIRECT

# File Per Table
innodb_file_per_table = 1

# I/O Capacity
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8

# Purge Threads
innodb_purge_threads = 4

# Lock Wait Timeout
innodb_lock_wait_timeout = 50

# Deadlock Detection
innodb_deadlock_detect = ON

# ============================================
# Query Cache (Disabled in MySQL 8.0+)
# ============================================
# query_cache_type = 0
# query_cache_size = 0
# query_cache_limit = 0

# ============================================
# Table Cache
# ============================================
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 65535

# ============================================
# Temporary Tables
# ============================================
tmp_table_size = 256M
max_heap_table_size = 256M

# ============================================
# Sort Buffer
# ============================================
sort_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
join_buffer_size = 4M

# ============================================
# Binary Logging (for replication/backups)
# ============================================
log_bin = /var/lib/mysql/mysql-bin.log
binlog_format = ROW
binlog_row_image = FULL
expire_logs_days = 7
max_binlog_size = 1G

# ============================================
# Slow Query Log
# ============================================
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2
log_queries_not_using_indexes = 1

# ============================================
# General Query Log (disable in production)
# ============================================
general_log = 0
general_log_file = /var/log/mysql/general.log

# ============================================
# Error Log
# ============================================
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# ============================================
# Performance Schema (enable for monitoring)
# ============================================
performance_schema = ON
performance_schema_instrument = '%=ON'

# ============================================
# SQL Mode
# ============================================
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ============================================
# Security Settings
# ============================================
local_infile = 0
skip_name_resolve = 1

# ============================================
# Replication Settings (if applicable)
# ============================================
# server-id = 1
# relay-log = /var/lib/mysql/relay-bin
# relay-log-index = /var/lib/mysql/relay-bin.index

# ============================================
# ERP-Specific Optimizations
# ============================================

# For large JOIN operations
join_buffer_size = 8M

# For ORDER BY operations
sort_buffer_size = 8M

# For GROUP BY operations
tmp_table_size = 512M
max_heap_table_size = 512M

# For full-text searches (if needed)
ft_min_word_len = 3
ft_max_word_len = 84

# ============================================
# Partitioning Considerations
# ============================================
# For stock_movements table with high volume:
# Consider partitioning by date for better performance
# Example: PARTITION BY RANGE (YEAR(created_at))

# ============================================
# Monitoring Settings
# ============================================
# Enable performance schema for index usage monitoring
performance_schema = ON

# Enable status variables monitoring
# Monitor: Innodb_buffer_pool_reads, Innodb_buffer_pool_read_requests
# Monitor: Handler_read_first, Handler_read_key, Handler_read_next
# Monitor: Select_scan, Select_full_join

# ============================================
# Backup Configuration
# ============================================
# Ensure enough disk space for backups
# Set up automated backups using mysqldump or Percona XtraBackup

# ============================================
# Notes for Different Server Sizes
# ============================================

# Small Server (4GB RAM, 2 CPU cores)
# innodb_buffer_pool_size = 2.5G
# innodb_buffer_pool_instances = 2
# innodb_log_file_size = 512M
# innodb_io_capacity = 1000
# innodb_io_capacity_max = 2000

# Medium Server (8GB RAM, 4 CPU cores)
# innodb_buffer_pool_size = 5G
# innodb_buffer_pool_instances = 4
# innodb_log_file_size = 1G
# innodb_io_capacity = 2000
# innodb_io_capacity_max = 4000

# Large Server (16GB RAM, 8 CPU cores)
# innodb_buffer_pool_size = 12G
# innodb_buffer_pool_instances = 8
# innodb_log_file_size = 2G
# innodb_io_capacity = 4000
# innodb_io_capacity_max = 8000

# ============================================
# Restart Required
# ============================================
# After changing these settings, restart MySQL:
# sudo systemctl restart mysql
# or
# sudo service mysql restart

# ============================================
# Verification
# ============================================
# Check settings after restart:
# SHOW VARIABLES LIKE 'innodb_buffer_pool_size';
# SHOW VARIABLES LIKE 'innodb_log_file_size';
# SHOW VARIABLES LIKE 'max_connections';

# Monitor performance:
# SHOW ENGINE INNODB STATUS;
# SHOW GLOBAL STATUS;
